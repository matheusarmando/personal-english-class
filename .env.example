NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Só no servidor — nunca prefixar com NEXT_PUBLIC_. Vem em
# Project Settings > API do Supabase ("service_role" key).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Meta WhatsApp Cloud API (Meta Business Manager > WhatsApp > Configuração da API)
WHATSAPP_CLOUD_API_TOKEN=your-whatsapp-cloud-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Qualquer string secreta escolhida por você; precisa bater com o
# "Verify token" configurado no webhook do Meta Business Manager.
WHATSAPP_VERIFY_TOKEN=your-own-secret-string

# Protege /api/whatsapp/cron e as rotas de cron do Google Calendar.
# Na Vercel, defina esta env var no projeto e o Vercel Cron já envia
# o header Authorization correspondente sozinho.
CRON_SECRET=your-own-secret-string

# Google Cloud Console > APIs & Services > Credentials (OAuth client
# ID do tipo "Web application"). Ver README para o passo a passo
# completo, incluindo as URIs de redirecionamento por ambiente.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Tem que bater exatamente com uma das "Authorized redirect URIs"
# cadastradas no Google Cloud Console, incluindo o protocolo.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/oauth/callback
